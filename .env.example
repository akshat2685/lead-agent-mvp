TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
GOOGLE_SHEET_URL=
SHEET_SYNC_INTERVAL_SECONDS=300
ZAPIER_WEBHOOK_SECRET=

# Optional Telegram chatbot LLM. Keep the real key only in local .env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MAX_TOKENS=450
OPENROUTER_SITE_URL=http://127.0.0.1:8765
OPENROUTER_APP_NAME=Edysor Lead Agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=450

# Zoho CRM OAuth/API settings. Fill these when credentials are ready.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com
ZOHO_MODULE=Leads
ZOHO_PER_PAGE=100

# Voice provider. Use mock until Vapi credentials are ready.
VOICE_PROVIDER=mock

# Sicada/Priya outbound calling. Keep the real API key only in your local .env.
SICADA_API_KEY=
SICADA_AGENT_ID=
SICADA_CALL_ENDPOINT=
SICADA_AUTH_HEADER=Authorization
SICADA_AUTH_SCHEME=Bearer
SICADA_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_BASE_URL=

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_API_BASE=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=
